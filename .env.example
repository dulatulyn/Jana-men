# Optional overrides for `docker compose up` (copy to .env). Everything has a default.

# Secret for signing JWTs (≥16 chars). Set a long random value outside local demos.
JWT_SECRET=

AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low

# Claude API key for the HR assistant. Empty → keyword-search fallback mode.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Host ports, if 3000/8000 are taken on your machine.
WEB_PORT=3000
API_PORT=8000
