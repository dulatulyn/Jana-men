DATABASE_URL=postgresql://janamen:janamen@localhost:5432/janamen?schema=public
# Required (≥16 chars) when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string
PORT=8000
CORS_ORIGINS=http://localhost:3000
INTEGRATIONS_MODE=mock
INTEGRATIONS_TIMEOUT_MS=10000
INTEGRATIONS_SYNC_TIMEOUT_MS=60000
# Used by `npm test`; the database name must contain "test".
TEST_DATABASE_URL=postgresql://janamen:janamen@localhost:5432/janamen_test?schema=public
