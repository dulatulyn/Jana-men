{
  "name": "janamen-ai",
  "version": "1.0.0",
  "description": "JanaMen HR-assistant service",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=.env eval/run.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "serve": "tsx --env-file-if-exists=.env src/index.ts"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "openai": "^7.36.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "private": true,
  "engines": {
    "node": ">=22.9"
  }
}
